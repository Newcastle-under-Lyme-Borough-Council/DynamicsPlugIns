    <property name="locality" display-name-key="Locality" description-key="lLocality" of-type="SingleLine.Text" usage="bound" required="false" /> 
    <property name="towncity" display-name-key="TownCity" description-key="TownCity" of-type="SingleLine.Text" usage="bound" required="false" /> 
    <property name="county" display-name-key="County" description-key="County" of-type="SingleLine.Text" usage="bound" required="false" />
    <property name="country" display-name-key="Country" description-key="Country" of-type="SingleLine.Text" usage="bound" required="false" /> 
